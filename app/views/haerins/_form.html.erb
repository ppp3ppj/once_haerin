<%= form_with(model: haerin, class: "space-y-4") do |form| %>
  <% if haerin.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul class="list-disc ml-4">
        <% haerin.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <label class="form-control w-full">
    <div class="label">
      <%= form.label :title, class: "label-text font-medium" %>
    </div>
    <%= form.text_field :title, class: "input input-bordered w-full #{haerin.errors[:title].any? ? 'input-error' : ''}" %>
  </label>

  <label class="form-control w-full">
    <div class="label">
      <%= form.label :description, class: "label-text font-medium" %>
    </div>
    <%= form.textarea :description, rows: 4, class: "textarea textarea-bordered w-full #{haerin.errors[:description].any? ? 'textarea-error' : ''}" %>
  </label>

  <label class="form-control w-full">
    <div class="label">
      <%= form.label :image, class: "label-text font-medium" %>
    </div>
    <%= form.file_field :image, class: "file-input file-input-bordered w-full" %>
  </label>

  <%= form.submit class: "btn btn-primary w-full sm:w-auto" %>
<% end %>
