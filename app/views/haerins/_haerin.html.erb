<div id="<%= dom_id haerin %>" class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
  <% if haerin.image.attached? %>
    <figure>
      <%= image_tag haerin.image, class: "w-full h-48 object-cover" %>
    </figure>
  <% end %>
  <div class="card-body">
    <h2 class="card-title"><%= haerin.title %></h2>
    <p class="text-base-content/70 text-sm line-clamp-3"><%= haerin.description %></p>
    <div class="card-actions justify-end mt-2">
      <%= link_to "Show", haerin, class: "btn btn-sm btn-ghost" %>
      <%= link_to "Edit", edit_haerin_path(haerin), class: "btn btn-sm btn-outline" %>
      <%= button_to "Delete", haerin, method: :delete, class: "btn btn-sm btn-error btn-outline", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
</div>
