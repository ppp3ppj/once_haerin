<% content_for :title,        "Haerins" %>
<% content_for :address,       "C:\\Once Minji\\Haerins" %>
<% content_for :status,        "#{@haerins.count} object(s) in folder" %>
<% content_for :status_right,  "#{@haerins.select { |h| h.image.attached? }.count} with image" %>

<%# ── Toolbar (extra actions for this view) ── %>
<div class="win-toolbar" style="border-top: 1px solid #fff;">
  <%= link_to "✚ New Haerin", new_haerin_path, class: "win-btn win-btn-sm win-btn-primary" %>
  <div class="win-toolbar-sep"></div>
  <span style="font-size: 11px; color: #808080;">View:</span>
  <span class="win-btn win-btn-sm win-btn-active" title="Details">☰</span>
</div>

<%# ── File list ── %>
<div class="win-listview">

  <%# Column headers %>
  <div class="win-listview-header">
    <div class="win-listview-col" style="width:32px;"> </div>
    <div class="win-listview-col" style="flex:1;">Name</div>
    <div class="win-listview-col" style="width:220px;">Description</div>
    <div class="win-listview-col" style="width:90px;">Modified</div>
    <div class="win-listview-col" style="width:80px;">Image</div>
    <div class="win-listview-col" style="width:130px; border-right: none;">Actions</div>
  </div>

  <%# Rows %>
  <div id="haerins">
    <% if @haerins.any? %>
      <% @haerins.each do |haerin| %>
        <%= render haerin %>
      <% end %>
    <% else %>
      <div style="display:flex; align-items:center; justify-content:center; padding: 40px; color: #808080; font-size:11px;">
        This folder is empty.
      </div>
    <% end %>
  </div>

</div>
